    <!-- Setup guide notification -->
    <string name="setup_notif_channel">Setup help</string>
    <string name="setup_notif_channel_desc">Guides you through connecting HiLight Plus to the rear lights.</string>
    <string name="setup_notif_build_title">Tap Build number 7 times</string>
    <string name="setup_notif_build_text">It\'s at the bottom of About phone. Keep tapping until you see \"You are now a developer\".</string>
    <string name="setup_notif_wifi_title">Connect to Wi-Fi</string>
    <string name="setup_notif_wifi_text">Wireless debugging only works on Wi-Fi.</string>
    <string name="setup_notif_wireless_title">Now turn on Wireless debugging</string>
    <string name="setup_notif_wireless_text">It\'s in Developer options. Tap here to go straight there.</string>
    <string name="setup_notif_pair_title">Tap Pair device with pairing code</string>
    <string name="setup_notif_pair_text">Tap Wireless debugging, then Pair device with pairing code.</string>
    <string name="setup_notif_code_title">Type the 6-digit code</string>
