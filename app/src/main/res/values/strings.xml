    <string name="setup_notif_wrong_text">Tap Pair device with pairing code again for a new one.</string>
    <string name="setup_notif_failed_title">Couldn\'t connect</string>
    <string name="setup_notif_failed_text">Open HiLight Plus to try again.</string>
    <string name="setup_notif_open_app">Open HiLight Plus</string>
    <string name="setup_notif_done_title">You\'re all set</string>
    <string name="setup_notif_done_text">HiLight Plus is connected to the rear lights.</string>
    <string name="setup_notif_network_title">Allow Wireless debugging on this Wi-Fi</string>
    <string name="setup_notif_network_text">HiLight Plus needs it for a few seconds to start the lights. Tap here, then choose Always allow on this network when Android asks.</string>

    <!-- Onboarding Step 4: Permissions -->
    <string name="onboarding_perms_title">Permissions</string>
    <string name="onboarding_perms_subtitle">HiLight Plus needs your contacts and your notifications so it knows who is calling or messaging and when to light up.</string>
    <string name="onboarding_perms_calls_title">Contacts</string>
    <string name="onboarding_perms_calls_granted_desc">Contacts access is granted. Callers and senders can be matched to your rules.</string>
    <string name="onboarding_perms_calls_needed_desc">Needed to tell saved contacts from unknown callers and to pick contacts for rules. Calls themselves are noticed through notification access.</string>
    <string name="onboarding_perms_calls_status_granted">Granted</string>
    <string name="onboarding_perms_calls_status_needed">Needed</string>
    <string name="onboarding_perms_calls_btn_grant">Grant access</string>
    <string name="onboarding_perms_calls_btn_app_info">App info</string>
    <string name="onboarding_perms_notif_title">Notification access</string>
    <string name="onboarding_perms_notif_granted_desc">Notification access is granted and listening.</string>
    <string name="onboarding_perms_notif_not_running_desc">Access is granted but the listener has stopped. Turn it off and on again in settings if alerts stop lighting.</string>
    <string name="onboarding_perms_notif_status_not_running">Not running</string>
    <string name="onboarding_perms_notif_needed_desc">Needed to notice incoming calls and new notifications from your apps and contacts.</string>
    <string name="onboarding_perms_notif_status_needed">Needed</string>
    <string name="onboarding_perms_notif_btn_enable">Allow notification access</string>

