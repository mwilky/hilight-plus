<resources>
    <string name="app_name">HiLight Plus</string>

    <!-- Onboarding Step 1: Welcome & Features -->
    <string name="onboarding_title">Welcome to HiLight Plus</string>
    <string name="onboarding_subtitle">HiLight Plus gives you full control over the rear LED lights on your pixel device. It allows you to set up custom rules for incoming calls and notifications.</string>
    <string name="onboarding_feature_calls_title">Incoming calls</string>
    <string name="onboarding_feature_calls_desc">Assign unique animated LED patterns and vibrant colors to specific contacts or unknown callers.</string>
    <string name="onboarding_feature_notifs_title">Notifications</string>
    <string name="onboarding_feature_notifs_desc">Custom rules for notifications from specific apps or contacts.</string>
    <string name="onboarding_feature_conditions_title">Conditions</string>
    <string name="onboarding_feature_conditions_desc">Customisable conditions to determine whether the lights should display or not.</string>

    <!-- Onboarding Step 2: Stock HiLight Conflict -->
    <string name="onboarding_stock_title">Native HiLight</string>
    <string name="onboarding_stock_desc1">Pixel\'s built-in HiLight feature has a basic \'Calls from favourites\' mode. If left enabled in system settings, both the native system and HiLight Plus will try to control the rear light array simultaneously.</string>
    <string name="onboarding_stock_desc2">Disabling the native \'Calls from favourites\' allows HiLight Plus to have full, exclusive control over the lights without conflicts.</string>
    <string name="onboarding_stock_card_title">Native HiLight settings</string>
    <string name="onboarding_stock_conflict_active_desc">Calls from favourites is currently active in system settings and will conflict with HiLight Plus. Please tap below to disable it.</string>
    <string name="onboarding_stock_ready_desc">Native setting disabled. HiLight Plus has exclusive access to the rear lights.</string>
    <string name="onboarding_stock_status_conflict">Conflict Active</string>
    <string name="onboarding_stock_status_ready">Ready</string>
    <string name="onboarding_stock_btn_open">Open settings to disable</string>

    <!-- Onboarding Step 3: Shizuku Hardware Access -->
    <string name="onboarding_shizuku_title">Shizuku</string>
    <string name="onboarding_shizuku_desc">Pixel devices do not expose public APIs to directly control rear hardware LEDs. HiLight Plus uses Shizuku to communicate with hardware drivers, without requiring root access.</string>
    <string name="onboarding_shizuku_session_title">Shizuku access</string>
    <string name="onboarding_shizuku_status_needs_auth">Authorization needed</string>
    <string name="onboarding_shizuku_btn_authorize">Authorize shizuku</string>
    <string name="onboarding_shizuku_btn_install">Install shizuku manager</string>
    <string name="onboarding_shizuku_btn_open">Open shizuku</string>
    <string name="onboarding_shizuku_btn_check_again">Check again</string>
    <string name="onboarding_shizuku_btn_retry">Retry connection</string>

    <!-- Onboarding Step 4: Permissions -->
    <string name="onboarding_perms_title">Required permissions</string>
    <string name="onboarding_perms_subtitle">Grant permissions so HiLight Plus can detect incoming calls, contacts, and app notifications in real-time.</string>
    <string name="onboarding_perms_calls_title">1. Calls &amp; contacts access</string>
    <string name="onboarding_perms_calls_granted_desc">Phone state, call log, and contacts permissions are active. Incoming caller identification is ready.</string>
    <string name="onboarding_perms_calls_needed_desc">Required to detect incoming phone calls and match caller numbers against your saved contact rules.</string>
    <string name="onboarding_perms_calls_status_granted">Granted</string>
    <string name="onboarding_perms_calls_status_needed">Permissions required</string>
    <string name="onboarding_perms_calls_btn_grant">Grant access</string>
    <string name="onboarding_perms_calls_btn_app_info">App info</string>
    <string name="onboarding_perms_notif_title">2. Notification listener access</string>
    <string name="onboarding_perms_notif_granted_desc">Notification listener is active. App notifications and chat messages trigger alerts smoothly.</string>
    <string name="onboarding_perms_notif_needed_desc">Notification listener access is required to detect incoming notifications.</string>
    <string name="onboarding_perms_notif_status_needed">Access required</string>
    <string name="onboarding_perms_notif_btn_enable">Enable notification access</string>

