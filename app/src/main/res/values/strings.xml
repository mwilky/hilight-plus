<resources>
    <string name="app_name">HiLight Plus</string>

    <!-- Onboarding Step 1: Welcome & Features -->
    <string name="onboarding_title">Welcome to HiLight Plus</string>
    <string name="onboarding_subtitle">Take control of the rear lights on your Pixel with your own rules for calls and notifications.</string>
    <string name="onboarding_feature_calls_title">Incoming calls</string>
    <string name="onboarding_feature_calls_desc">Give each contact, or unknown callers, their own colour and light pattern. Works for phone calls and app calls like WhatsApp.</string>
    <string name="onboarding_feature_notifs_title">Notifications</string>
    <string name="onboarding_feature_notifs_desc">Light up differently for specific apps and contacts.</string>
    <string name="onboarding_feature_conditions_title">Conditions</string>
    <string name="onboarding_feature_conditions_desc">Choose conditions that stop the lights from showing.</string>
    <string name="onboarding_feature_battery_title">Battery</string>
    <string name="onboarding_feature_battery_desc">Show a charging gauge or low-battery warning on the ring.</string>

    <!-- Onboarding Step 2: Stock HiLight Conflict -->
    <string name="onboarding_stock_title">Pixel\'s built-in HiLight</string>
    <string name="onboarding_stock_desc1">Your Pixel already has a simple HiLight option called \'Calls from favourites\'. If it stays on, it and HiLight Plus will both try to drive the rear lights at the same time.</string>
    <string name="onboarding_stock_desc2">Turn it off in system settings so HiLight Plus has the lights to itself. Gemini and other system features can still use them.</string>
    <string name="onboarding_stock_card_title">Calls from favourites</string>
    <string name="onboarding_stock_conflict_active_desc">This is still on in system settings and will clash with HiLight Plus. Tap below to turn it off.</string>
    <string name="onboarding_stock_unknown_desc">Couldn\'t read this setting yet. Connect HiLight Plus to the ring to check it.</string>
    <string name="onboarding_stock_status_conflict">Still on</string>
    <string name="onboarding_stock_status_ready">Off</string>
    <string name="onboarding_stock_status_unknown">Unknown</string>
    <string name="onboarding_stock_btn_open">Open system settings</string>

    <!-- Onboarding Step 3: Connect to the ring (built-in connection, Shizuku optional) -->
    <string name="connect_title">Connect to the ring</string>
    <string name="connect_desc">Android only lets the phone\'s own developer tools reach the rear lights, so HiLight Plus uses them, entirely on your phone. Three switches, once, and each one ticks itself off.</string>
    <string name="connect_step_dev_title">Turn on Developer options</string>
    <string name="connect_step_dev_desc">Tap Build number 7 times. HiLight Plus opens the right screen for you.</string>
    <string name="connect_step_dev_done">Developer options is on.</string>
    <string name="connect_step_dev_btn">Open About phone</string>
    <string name="connect_step_wireless_title">Turn on Wireless debugging</string>
    <string name="connect_step_wireless_desc">Switch on Wireless debugging. If you\'re asked, allow it on this network.</string>
    <string name="connect_step_wireless_done">Wireless debugging is on.</string>
    <string name="connect_step_wireless_btn">Open Developer options</string>
    <string name="connect_step_wifi_desc">Connect to Wi-Fi first. Wireless debugging only works on Wi-Fi, not mobile data.</string>
    <string name="connect_step_pair_title">Pair with HiLight Plus</string>
    <string name="connect_step_pair_desc">Tap Wireless debugging, then Pair device with pairing code. Type the 6-digit code into HiLight Plus\'s notification.</string>
    <string name="connect_step_pair_desc_in_app">Tap Wireless debugging, then Pair device with pairing code. Come back here and type the 6-digit code.</string>
    <string name="connect_step_pair_code_desc">Type the 6-digit code shown under Pair device with pairing code.</string>
    <string name="connect_step_pair_connecting">Connecting&#8230;</string>
    <string name="connect_step_pair_wrong">That code didn\'t match. Tap Pair device with pairing code again for a new one.</string>
    <string name="connect_step_pair_failed">Paired, but the lights service didn\'t start. Try again.</string>
    <string name="connect_step_pair_btn">Open Wireless debugging</string>
    <string name="connect_step_pair_retry">Try again</string>
    <string name="connect_code_label">Pairing code</string>
    <string name="connect_code_btn">Pair</string>
    <string name="connect_use_shizuku">Already use Shizuku?</string>
    <string name="connect_use_builtin">Use the built-in connection instead</string>
    <string name="onboarding_connect_skip_title">Continue without connecting?</string>
    <string name="onboarding_connect_skip_desc">You can set up rules, but the rear lights won\'t do anything until HiLight Plus is connected. The card on the Home screen will walk you through it whenever you\'re ready.</string>
    <string name="onboarding_connect_skip_confirm">Continue anyway</string>
    <string name="onboarding_connect_skip_cancel">Go back</string>

    <!-- Connect screen (from Home, About, or the switch-over prompt) -->
    <string name="connect_screen_close">Not now</string>
    <string name="connect_screen_done">Done</string>
    <string name="connect_success_title">You\'re all set</string>
    <string name="connect_success_desc">HiLight Plus now connects by itself, including after a restart. To keep the lights working, leave Developer options on, with Wireless debugging or USB debugging on too.</string>
    <string name="connect_success_shizuku_title">Shizuku</string>
    <string name="connect_success_shizuku_desc">HiLight Plus doesn\'t need Shizuku any more. You can uninstall it if nothing else uses it.</string>
    <string name="connect_success_shizuku_status">Not needed</string>
    <string name="connect_success_shizuku_btn">Open Shizuku\'s app info</string>

    <!-- One-time prompt for people updating from a Shizuku-only version -->
    <string name="migration_title">HiLight Plus no longer needs Shizuku</string>
    <string name="migration_desc">Connect once and the app looks after itself: no second app to keep running, and it reconnects after a restart.</string>
    <string name="migration_switch">Switch now (about 30 seconds)</string>
    <string name="migration_not_now">Not now</string>

