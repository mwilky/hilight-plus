    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <group>
        <!-- Everything except a disc round the badge: the square runs clockwise and the disc
             anticlockwise, so the disc is a hole under the default non-zero fill rule. -->
        <clip-path
            android:pathData="M0,0H24V24H0Z M12.2,18.6a6.4,6.4 0,1 0,12.8 0a6.4,6.4 0,1 0,-12.8 0Z" />
